# 复制为 .env 后填写

ADDR=:8080
# 挂在子路径下时填，如 /tg
BASE_PATH=
# 对外完整地址（含 BASE_PATH，不带末尾斜杠）。填了通知上才有"回复"和"打开 Telegram"按钮
PUBLIC_URL=https://example.com/tg
# 只信任这些反代传来的 X-Forwarded-For（登录限速按真实来源 IP）
TRUSTED_PROXIES=127.0.0.1,::1
DATA_DIR=./data
PPROF=false
# debug 会打印每条收到的消息（只有元数据，不含正文）
LOG_LEVEL=info

# 随机字符串，用于签名登录 cookie；生成：openssl rand -hex 32
SESSION_SECRET=
# 随机字符串，用于加密 TG session；生成：openssl rand -hex 32。换了它所有 TG 账号都要重新扫码
MASTER_KEY=

# 首次启动种子创建的管理员，密码留空则不创建
ADMIN_USER=admin
ADMIN_PASSWORD=

# Telegram API 凭据，https://my.telegram.org 申请，平台统一一套
TG_API_ID=
TG_API_HASH=

# 自建 ntfy：平台用一个 admin 角色的服务账号建用户、发消息。
# 名字不要和任何平台用户重名（平台用户会在 ntfy 里建同名普通用户）
NTFY_URL=https://ntfy.example.com
# ntfy 容器自己也要知道对外地址（生成链接、iOS 唤醒用），与 NTFY_URL 相同
NTFY_BASE_URL=https://ntfy.example.com
NTFY_USER=tg-service
NTFY_PASSWORD=
# 自建 bark
BARK_URL=https://bark.example.com

# 消息元数据（对话、发送者、时间、推送结果）保留天数，正文只在内存里推送、不落库
RETENTION_DAYS=7
